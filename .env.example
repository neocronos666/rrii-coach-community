# Entorno exclusivamente local. Reemplazar la contraseña antes del primer uso.
COMPOSE_PROJECT_NAME=rrii-coach

POSTGRES_DB=rrii_coach
POSTGRES_USER=rrii_coach
POSTGRES_PASSWORD=change_me

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_ECHO=false

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

ASSET_STORAGE_PATH=/data/assets

# Límite técnico por archivo (256 MiB); no es una preferencia del dispositivo.
ASSET_MAX_UPLOAD_BYTES=268435456
